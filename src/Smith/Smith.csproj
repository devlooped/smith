<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Preview</LangVersion>
    <PackageId>Smith</PackageId>
    <RootNamespace>Smith</RootNamespace>
    <Description>Run AI-powered C# files using Microsoft.Extensions.AI and Devlooped.Extensions.AI</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="NuGetizer" Version="1.4.7" PrivateAssets="all" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.4.1" />
    <PackageReference Include="Devlooped.Extensions.AI" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Smith.props" PackFolder="build" />
    <None Update="Smith.targets" PackFolder="build" />
  </ItemGroup>

</Project>